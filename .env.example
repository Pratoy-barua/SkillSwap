# Copy this file to .env and replace every development secret before deployment.
FLASK_ENV=development
SECRET_KEY=replace-with-a-long-random-secret

MYSQL_DATABASE=skillswap
MYSQL_USER=skillswap_user
MYSQL_PASSWORD=replace-with-a-strong-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# Optional: override the individual MYSQL_* fields with a complete SQLAlchemy URL.
# DATABASE_URL=mysql+pymysql://skillswap_user:password@127.0.0.1:3306/skillswap?charset=utf8mb4
MAX_CONTENT_LENGTH=10485760

# Admin setup (used only by `flask --app app seed-admin`; never commit .env)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-12-character-admin-password
